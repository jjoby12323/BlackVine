[Unit]
Description=BlackVine Light Notification Server
After=network-online.target
Wants=network-online.target

[Service]
# Replace angoor_pi with your username if different
Type=simple
User=angoor_pi
WorkingDirectory=/home/angoor_pi/blackvine
EnvironmentFile=/home/angoor_pi/blackvine/.env
ExecStart=/home/angoor_pi/blackvine/venv/bin/gunicorn -w 1 --threads 4 -b 0.0.0.0:5000 "server.app:create_app()"
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
